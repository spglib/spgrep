{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: {
    enabled: true,
  },
  'pre-commit': {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    platformAutomerge: true,
  },
  separateMultipleMajor: true,
  minimumReleaseAge: '7d',
  configMigration: true,
  extends: [
    'config:recommended',
    'schedule:weekly',
    ':semanticCommitTypeAll(chore)',
    ':label(renovate)',
    'helpers:pinGitHubActionDigests',
  ],
  enabledManagers: [
    'github-actions',
    'pep621',
    'pre-commit',
  ],
  packageRules: [
    {
      description: 'Automerge patch updates',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      groupName: 'CI and devDependencies',
      matchManagers: [
        'github-actions',
        'pre-commit',
      ],
    },
    {
      description: 'Automerge CI and devDependencies non-major updates',
      matchManagers: [
        'github-actions',
        'pre-commit',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchDepNames: [
        'python',
      ],
      enabled: false,
    },
    {
      groupName: 'python',
      matchManagers: [
        'pep621',
      ],
    },
  ],
}
